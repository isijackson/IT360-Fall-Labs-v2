// Jenkinsfile with one extra stage: a local open-weight model (Docker Model Runner, no API key, nothing
// leaves the laptop) reviews the Dockerfile before the push. Requires Docker Desktop 4.40+ with Model
// Runner enabled on the Jenkins host and: docker model pull ai/smollm2
pipeline {
    agent any
    environment {
        IMAGE_NAME = "${env.IMAGE_NAME ?: 'YOUR_DOCKERHUB_USER/menu-board'}"
        REGISTRY   = "${env.REGISTRY_URL ?: 'https://index.docker.io/v1/'}"
    }
    stages {
        stage('Checkout') { steps { checkout scm } }
        stage('AI review (local model)') {
            steps {
                sh '''
                  docker model run ai/smollm2 "You are a Docker reviewer. In five bullet points, review this Dockerfile for image size, pinning and security: $(cat Dockerfile)" \
                    | tee ai-review.txt
                '''
                archiveArtifacts artifacts: 'ai-review.txt'
            }
        }
        stage('Build')      { steps { script { docker.build("${IMAGE_NAME}:${BUILD_NUMBER}") } } }
        stage('Smoke test') {
            // On a Jenkins VM the container is reached on localhost:18080. When Jenkins itself runs in Docker
            // (SMOKE_NET set), it is reached by container name over that Docker network instead.
            steps {
                script {
                    def net  = env.SMOKE_NET ? "--network ${env.SMOKE_NET}" : ""
                    def url  = env.SMOKE_NET ? "http://smoke-${BUILD_NUMBER}/" : "http://localhost:18080/"
                    docker.image("${IMAGE_NAME}:${BUILD_NUMBER}").withRun("-p 18080:80 --name smoke-${BUILD_NUMBER} ${net}") { c ->
                        sh "sleep 2; curl -sf -o /dev/null -w 'HTTP %{http_code}\\n' ${url}"
                    }
                }
            }
        }
        stage('Push') { steps { script {
            docker.withRegistry(REGISTRY, 'dockerhub-credentials') {
                def img = docker.image("${IMAGE_NAME}:${BUILD_NUMBER}"); img.push("${BUILD_NUMBER}"); img.push('latest') } } } }
    }
}
